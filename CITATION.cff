    given-names: Enes
  - family-names: Yalçınkaya
    given-names: Hasan
repository-code: "https://github.com/enesdikmen/bee-around"
url: "https://enesdikmen.github.io/bee-around/"
license: MIT
keywords:
  - biodiversity
  - GBIF
  - open data
  - data visualization
  - science outreach
  - data literacy
